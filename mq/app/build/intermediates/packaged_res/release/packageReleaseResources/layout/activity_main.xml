<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/ic_launcher_background"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:elevation="4dp">

        <!-- Logo with white background -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/logo_background"
            android:layout_marginEnd="12dp"
            android:padding="4dp">
            <ImageView
                android:id="@+id/navLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/mq_logo"
                android:contentDescription="MQ School of Mathematics Logo"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <!-- Company Name -->
        <TextView
            android:id="@+id/navTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MQ School of Mathematics"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center_vertical" />

    </LinearLayout>

    <!-- WebView -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/ic_launcher_background"
        android:padding="10dp"
        android:elevation="4dp">

        <!-- Date/Time -->
        <TextView
            android:id="@+id/footerDateTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Loading..."
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginBottom="4dp" />

        <!-- Android Version -->
        <TextView
            android:id="@+id/footerAndroidVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Android Version: Loading..."
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginBottom="4dp" />

        <!-- Copyright -->
        <TextView
            android:id="@+id/footerCopyright"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="© 2024 MQ School of Mathematics. All rights reserved."
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:gravity="center"
            android:textStyle="italic" />

    </LinearLayout>

</LinearLayout>

