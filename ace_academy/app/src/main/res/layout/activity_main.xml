<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor">

<LinearLayout
    android:id="@+id/mainContent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Navigation Bar with Enhanced Design -->
    <LinearLayout
        android:id="@+id/navigationBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/gradient_header"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:elevation="8dp">

        <!-- Logo with animated background -->
        <androidx.cardview.widget.CardView
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:cardCornerRadius="25dp"
            app:cardElevation="4dp"
            android:layout_marginEnd="16dp">
            
            <ImageView
                android:id="@+id/navLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ace_logo"
                android:contentDescription="Ace Academy Logo"
                android:scaleType="centerCrop"
                android:padding="6dp"
                android:background="@android:color/white" />
        </androidx.cardview.widget.CardView>

        <!-- Company Name with shadow -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            
            <TextView
                android:id="@+id/navTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ace Academy"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:shadowColor="#40000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="4" />
            
            <TextView
                android:id="@+id/navSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Student Portal"
                android:textColor="@color/subtitleColor"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Teacher Image with border and shadow -->
        <androidx.cardview.widget.CardView
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:cardCornerRadius="30dp"
            app:cardElevation="6dp"
            android:layout_marginStart="12dp">
            
            <ImageView
                android:id="@+id/teacherImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/arif_sir"
                android:contentDescription="Arif Sir"
                android:scaleType="centerCrop"
                android:background="@drawable/circle_border" />
        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:progressTint="@color/colorAccent"
        android:progressBackgroundTint="@color/progressBackground"
        android:visibility="gone" />

    <!-- Swipe Refresh Layout with WebView -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Enhanced Footer with gradient -->
    <LinearLayout
        android:id="@+id/footerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/gradient_footer"
        android:padding="12dp"
        android:elevation="8dp">

        <!-- Date/Time with icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="6dp">
            
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_clock"
                android:contentDescription="Clock Icon"
                android:tint="@android:color/white"
                android:layout_marginEnd="8dp" />
            
            <TextView
                android:id="@+id/footerDateTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Android Version with icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="6dp">
            
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_android"
                android:contentDescription="Android Icon"
                android:tint="@android:color/white"
                android:layout_marginEnd="8dp" />
            
            <TextView
                android:id="@+id/footerAndroidVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Android Version: Loading..."
                android:textColor="@android:color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#40FFFFFF"
            android:layout_marginVertical="6dp" />

        <!-- Copyright with enhanced styling -->
        <TextView
            android:id="@+id/footerCopyright"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="© 2026 Ace Academy - Arif Sir. All rights reserved."
            android:textColor="@color/copyrightColor"
            android:textSize="11sp"
            android:gravity="center"
            android:textStyle="italic"
            android:shadowColor="#40000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2" />

    </LinearLayout>

</LinearLayout>

    <!-- HTML5 video fullscreen host (required for enabled fullscreen icon in WebView) -->
    <FrameLayout
        android:id="@+id/fullscreenVideoContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

</FrameLayout>
